APP_JAVA_TOOL_OPTIONS="-Xms512m -XX:MaxRAMPercentage=75.0 -XX:MaxMetaspaceSize=256m -XX:ReservedCodeCacheSize=256m -XX:+UseCompactObjectHeaders -Djava.security.egd=file:/dev/./urandom"
MONGODB_URI="mongodb://mongodb:27017/productsorter?maxPoolSize=500&connectTimeoutMS=5000&timeoutMS=5000&serverSelectionTimeoutMS=5000"
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=admin
JWT_JWK_SET_URI=http://keycloak:8080/realms/product-sorter/protocol/openid-connect/certs
LOGGING_LOKI_URL=http://loki:3100/loki/api/v1/push

# OpenTelemetry
OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# Keycloak admin
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Grafana admin
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
