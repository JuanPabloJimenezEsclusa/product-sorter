{
  "title": "Product Sorter",
  "tags": ["product-sorter", "java"],
  "schemaVersion": 38,
  "panels": [
    {
      "title": "Sort Requests",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "increase(sorting_requests_total{application='product-sorter'}[$__rate_interval])",
          "legendFormat": "requests"
        }
      ],
      "description": "Total number of sort requests"
    },
    {
      "title": "Sort Duration (p95)",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sorting_duration_seconds{application='product-sorter', quantile='0.95'}",
          "legendFormat": "p95"
        }
      ],
      "description": "95th percentile of sort duration"
    },
    {
      "title": "Sort Duration",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sorting_duration_seconds{application='product-sorter', quantile='0.50'}",
          "legendFormat": "p50"
        },
        {
          "expr": "sorting_duration_seconds{application='product-sorter', quantile='0.95'}",
          "legendFormat": "p95"
        },
        {
          "expr": "sorting_duration_seconds{application='product-sorter', quantile='0.99'}",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "Products per Sort",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sorting_products_max{application='product-sorter'}",
          "legendFormat": "max"
        },
        {
          "expr": "sorting_products_sum{application='product-sorter'} / sorting_products_count{application='product-sorter'}",
          "legendFormat": "avg"
        }
      ]
    },
    {
      "title": "Weights Distribution",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sorting_weights_sum{application='product-sorter', criterion='salesUnits'} / sorting_weights_count{application='product-sorter', criterion='salesUnits'}",
          "legendFormat": "sales units (avg)"
        },
        {
          "expr": "sorting_weights_sum{application='product-sorter', criterion='stockRatio'} / sorting_weights_count{application='product-sorter', criterion='stockRatio'}",
          "legendFormat": "stock ratio (avg)"
        }
      ]
    },
    {
      "title": "JVM Memory",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application='product-sorter'}",
          "legendFormat": "{{area}}"
        }
      ]
    },
    {
      "title": "HTTP Requests",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{application='product-sorter'}[1m])",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "title": "Cache Hit Ratio",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(cache_hits_total{application='product-sorter'}[1m]) / (rate(cache_hits_total{application='product-sorter'}[1m]) + rate(cache_misses_total{application='product-sorter'}[1m]))",
          "legendFormat": "L2 Redis"
        }
      ]
    },
    {
      "title": "Traces (Tempo)",
      "type": "tempo",
      "datasource": "Tempo",
      "query": "{service.name=\"product-sorter\"}"
    },
    {
      "title": "Application Logs",
      "type": "logs",
      "datasource": "Loki",
      "targets": [
        {
          "expr": "{container=\"product-sorter\"}",
          "legendFormat": ""
        }
      ]
    }
  ]
}
