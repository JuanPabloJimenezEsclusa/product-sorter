{
  "realm": "product-sorter",
  "enabled": true,
  "accessTokenLifespan": 3600,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Global role for administrators of the system"
      },
      {
        "name": "operator",
        "description": "Global role for operators of the system"
      }
    ]
  },
  "users": [
    {
      "username": "user",
      "email": "user@product-sorter.com",
      "firstName": "Product",
      "lastName": "Sorter",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "pass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin",
        "operator"
      ],
      "requiredActions": []
    },
    {
      "username": "service-account-product-sorter-client",
      "enabled": true,
      "serviceAccountClientId": "product-sorter-client",
      "realmRoles": [
        "operator",
        "admin"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "product-sorter-client",
      "secret": "product-sorter-secret",
      "enabled": true,
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": []
    },
    {
      "clientId": "app",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:8081/*"]
    }
  ]
}
