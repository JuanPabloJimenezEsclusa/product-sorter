{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "salesUnits": { "type": "integer" },
          "stock": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "size": { "type": "string" },
                "quantity": { "type": "integer" }
              },
              "required": ["size", "quantity"]
            }
          }
        },
        "required": ["id", "name", "salesUnits", "stock"]
      }
    },
    "page": { "type": "integer" },
    "size": { "type": "integer" }
  },
  "required": ["data", "page", "size"]
}
